FLASK_ENV=development
SECRET_KEY=change-me
# Turso (required in production)
TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
TURSO_AUTH_TOKEN=
# Uploadcare: images
UPLOADCARE_PUBLIC_KEY=
UPLOADCARE_SECRET_KEY=
# ImageKit: documents (private files)
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
SIGNED_URL_SECONDS=300
PLATFORM_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Cloudflare Turnstile (bot check on login, sign up and password reset) - dash.cloudflare.com -> Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Sign users out after this many idle minutes (website and installed app)
IDLE_TIMEOUT_MINUTES=30
# Biometric (fingerprint / face) sign-in. Leave blank to use the address people visit.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
# 1 = only inside the installed home-screen app, 0 = also in the browser
BIOMETRIC_INSTALLED_APP_ONLY=1
